<clothing>
	<coreAttributes>
		<value>1000</value> 
		
		<determiner><![CDATA[a pair of]]></determiner>
		
		<name><![CDATA[готический сапог]]></name>
		
		<namePlural pluralByDefault="true"><![CDATA[готические сапоги]]></namePlural> 
		
		<description><![CDATA[Пара женственных высоких сапог из высококачественной кожи. Множество ремешков и пряжек придают им истинно «готический» вид, хотя их функциональность сводится к минимуму благодаря молнии, идущей по внутренней стороне.]]></description> 
		
		<physicalResistance>1</physicalResistance> 
		
		<femininity>FEMININE</femininity> 
		
		<slot>FOOT</slot> 
		
		<rarity>COMMON</rarity> 
		
		<clothingSet/> 
		
		<imageName>goth_boots_fem.svg</imageName> 
		
		<imageEquippedName/> 
		
		<effects/>
		
		<blockedPartsList> 
		
			<blockedParts>
				<displacementType>REMOVE_OR_EQUIP</displacementType> 
				
				<clothingAccessRequired> 
					<clothingAccess>FEET</clothingAccess>
				</clothingAccessRequired>
				
				<blockedBodyParts>
					<bodyPart>FEET</bodyPart>
				</blockedBodyParts>
				
				<clothingAccessBlocked> 
					<clothingAccess>FEET</clothingAccess>
				</clothingAccessBlocked>
				
				<concealedSlots>
					<slot>SOCK</slot>
				</concealedSlots>
			</blockedParts>
			
		</blockedPartsList>
		
		<incompatibleSlots/> 
		
		<primaryColours values="JUST_BLACK"/> 
		<primaryColoursDye values="ALL"/>
		<secondaryColours values="JUST_STEEL"/>
		<secondaryColoursDye values="ALL_METAL"/>
		<tertiaryColours values="JUST_BLACK"/>
		<tertiaryColoursDye values="ALL"/>
		
		<itemTags> 
			<tag>SOLD_BY_NYAN</tag>
		</itemTags>
	</coreAttributes>

  <replacementText type="REMOVE_OR_EQUIP">
    <self>
      <![CDATA[[npc.Name] [npc.verb(slip)] [npc.her] [npc.feet] в сапоги, а затем застегивает их на молнию.]]>
    </self>
    <other>
      <![CDATA[[npc.Name] [npc.verb(slip)] [npc2.namePos] [npc2.feet] в сапоги, а затем застегивает их на молнию.]]>
    </other>
    <otherRough>
      <![CDATA[[npc.Name] грубо [npc.verb(push)] [npc2.namePos] [npc2.feet] в сапоги, а затем застегивает их на молнию.]]>
    </otherRough>
  </replacementText>

  <displacementText type="REMOVE_OR_EQUIP">
    <self>
      <![CDATA[[npc.Name] [npc.verb(unzip)] [npc.her] сапоги, прежде чем снять их.]]>
    </self>
    <other>
      <![CDATA[[npc.Name] [npc.verb(unzip)] [npc2.namePos] сапоги, прежде чем снять их.]]>
    </other>
    <otherRough>
      <![CDATA[[npc.Name] быстро [npc.verb(unzip)] [npc2.namePos] сапоги, а затем резко стягивает их.]]>
    </otherRough>
  </displacementText>
	
</clothing>
