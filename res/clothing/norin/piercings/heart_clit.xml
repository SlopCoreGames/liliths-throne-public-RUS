<?xml version="1.0" encoding="utf-8" standalone="no"?>

<clothing>
	<coreAttributes>
		<clothingAuthorTag><![CDATA[Мелкая гравировка сообщает тебе, что этот пирсинг был сделан мастером «Норин».]]></clothingAuthorTag>
		<value>150</value> <!--10 flames = £1 ~ $1.5-->
		<determiner><![CDATA[a]]></determiner>
		<name><![CDATA[серьга-барабан в форме сердца]]></name>
		<namePlural pluralByDefault="false"><![CDATA[серьги-штанги в форме сердечек]]></namePlural>
		<description><![CDATA[Штанга, которая окружает клитор обладательницы милым сердечком.]]></description>
		
		<physicalResistance>0</physicalResistance>
		<femininity>FEMININE</femininity> <!-- FEMININE, MASCULINE ANDROGYNOUS -->
		<slot>PIERCING_VAGINA</slot> <!-- slot values: https://github.com/Innoxia/liliths-throne-public/blob/master/src/com/lilithsthrone/game/inventory/InventorySlot.java -->
		<rarity>COMMON</rarity> <!-- rarity values: https://github.com/Innoxia/liliths-throne-public/blob/master/src/com/lilithsthrone/game/inventory/Rarity.java -->
		
		<imageName>heart_clit.svg</imageName>
		
		<clothingSet/> <!-- No way to define custom sets yet -->
		<imageEquippedName/> <!-- The file path for this clothing's image while equipped -->
		<effects/> <!-- Default enchantments -->

		<blockedPartsList>
		  <blockedParts>
			
			<displacementType>REMOVE_OR_EQUIP</displacementType> <!-- displacementType values: https://github.com/Innoxia/liliths-throne-public/blob/master/src/com/lilithsthrone/game/inventory/clothing/DisplacementType.java -->
			
			<clothingAccessRequired> <!-- clothingAccess values: https://github.com/Innoxia/liliths-throne-public/blob/master/src/com/lilithsthrone/game/inventory/clothing/ClothingAccess.java -->
			  <clothingAccess>GROIN</clothingAccess>
			</clothingAccessRequired>
			
			<blockedBodyParts/> <!--bodyPart values: https://github.com/Innoxia/liliths-throne-public/blob/master/src/com/lilithsthrone/game/character/body/CoverableArea.java -->
			<clothingAccessBlocked/> <!-- clothingAccess -->
			<concealedSlots/> <!-- slot -->
			
		  </blockedParts>
		</blockedPartsList>
		
		<incompatibleSlots/> <!-- slot(s) not compatible -->
		
		<primaryColours values="ALL_METAL"/>
		<primaryColoursDye/>
		<secondaryColours/>
		<secondaryColoursDye/>
		<tertiaryColours/>
		<tertiaryColoursDye/>
		
		<itemTags>
		  <tag>SOLD_BY_KATE</tag>
		</itemTags>
	</coreAttributes>
	
	<replacementText type="REMOVE_OR_EQUIP">
		<self>
			<![CDATA[[npc.Name] [npc.verb(slide)] сердцевидную штангу в вагинальный пирсинг [npc.her].]]>
		</self>
		<other>
			<![CDATA[[npc.Name] [npc.verb(slide)] сердцевидную штангу в вагинальный пирсинг [npc2.namePos].]]>
		</other>
		<otherRough>
			<![CDATA[[npc.Name] грубо [npc.verb(slide)] сердцевидную штангу в вагинальный пирсинг [npc2.namePos].]]>
		</otherRough>
	</replacementText>

	<displacementText type="REMOVE_OR_EQUIP">
		<self>
			<![CDATA[[npc.Name] [npc.verb(slide)] сердцевидную штангу [npc.her] из вагинального пирсинга [npc.her].]]>
		</self>
		<other>
			<![CDATA[[npc.Name] [npc.verb(slide)] сердцевидную штангу [npc2.namePos] из вагинального пирсинга [npc2.her].]]>
		</other>
		<otherRough>
			<![CDATA[[npc.Name] грубо [npc.verb(pull)] сердцевидную штангу [npc2.namePos] из вагинального пирсинга [npc2.her].]]>
		</otherRough>
	</displacementText>
	
</clothing>