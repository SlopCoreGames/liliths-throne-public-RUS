<?xml version="1.0" encoding="utf-8" standalone="no"?>

<clothing>
	<coreAttributes>
		<value>300</value> <!--10 flames = £1 ~ $1.5-->
		<determiner><![CDATA[a pair of]]></determiner>
		<name><![CDATA[серьги-штанги в форме сердечек]]></name>
		<namePlural pluralByDefault="true"><![CDATA[серьги-штанги в форме сердечек]]></namePlural>
		<description><![CDATA[Пара штанги, которые украшают каждый сосок милым сердечком.]]></description>
		
		<physicalResistance>0</physicalResistance>
		<femininity>FEMININE</femininity> <!-- FEMININE, MASCULINE ANDROGYNOUS -->
		<slot>PIERCING_NIPPLE</slot> <!-- slot values: https://github.com/Innoxia/liliths-throne-public/blob/master/src/com/lilithsthrone/game/inventory/InventorySlot.java -->
		<rarity>COMMON</rarity> <!-- rarity values: https://github.com/Innoxia/liliths-throne-public/blob/master/src/com/lilithsthrone/game/inventory/Rarity.java -->
		
		<imageName>heart_barbells.svg</imageName>
		
		<clothingSet/> <!-- No way to define custom sets yet -->
		<imageEquippedName/> <!-- The file path for this clothing's image while equipped -->
		<effects/> <!-- Default enchantments -->

		<blockedPartsList>
		  <blockedParts>
			
			<displacementType>REMOVE_OR_EQUIP</displacementType> <!-- displacementType values: https://github.com/Innoxia/liliths-throne-public/blob/master/src/com/lilithsthrone/game/inventory/clothing/DisplacementType.java -->
			
			<clothingAccessRequired> <!-- clothingAccess values: https://github.com/Innoxia/liliths-throne-public/blob/master/src/com/lilithsthrone/game/inventory/clothing/ClothingAccess.java -->
			  <clothingAccess>CHEST</clothingAccess>
			</clothingAccessRequired>
			
			<blockedBodyParts/> <!--bodyPart values: https://github.com/Innoxia/liliths-throne-public/blob/master/src/com/lilithsthrone/game/character/body/CoverableArea.java -->
			<clothingAccessBlocked/> <!-- clothingAccess -->
			<concealedSlots/> <!-- slot -->
			
		  </blockedParts>
		</blockedPartsList>
		
		<incompatibleSlots/> <!-- slot(s) not compatible -->
		
		<primaryColours values="ALL_METAL"/>
		<primaryColoursDye values="ALL_WITH_METALS"/>
		<secondaryColours values="ALL_METAL"/>
		<secondaryColoursDye values="ALL_WITH_METALS"/>
		<tertiaryColours/>
		<tertiaryColoursDye/>
		
		<itemTags>
		  <tag>SOLD_BY_KATE</tag>
		</itemTags>
		
	</coreAttributes>

	<replacementText type="REMOVE_OR_EQUIP">
		<self>
			<![CDATA[[npc.Name] [npc.verb(slide)] сердцевидные штанги в пирсинг [npc.her] соска.]]>
		</self>
		<other>
			<![CDATA[[npc.Name] [npc.verb(slide)] сердцевидные штанги в пирсинг [npc2.namePos] соска.]]>
		</other>
		<otherRough>
			<![CDATA[[npc.Name] грубо [npc.verb(slide)] сердцевидные штанги в пирсинг [npc2.namePos] соска.]]>
		</otherRough>
	</replacementText>

	<displacementText type="REMOVE_OR_EQUIP">
		<self>
			<![CDATA[[npc.Name] [npc.verb(slide)] [npc.her] сердцевидных штанги из пирсинга [npc.her] соска.]]>
		</self>
		<other>
			<![CDATA[[npc.Name] [npc.verb(slide)] [npc2.namePos] сердцевидных штанги из пирсинга [npc2.her] соска.]]>
		</other>
		<otherRough>
			<![CDATA[[npc.Name] грубо [npc.verb(pull)] [npc2.namePos] сердцевидных штанги из пирсинга [npc2.her] соска.]]>
		</otherRough>
	</displacementText>
  
</clothing>