<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<arm>
	<!-- GENERAL INFORMATION: If you are unsure of anything, please use the LT Discord to ask for help! -->
	
	<!-- If you want to see the part of the code where this type is defined, then please look here:
	https://github.com/Innoxia/liliths-throne-public/blob/dev/src/com/lilithsthrone/game/character/body/abstractTypes/AbstractArmType.java -->
	
	<!-- The id of the race which this arm belongs to.
	This will almost always be the id of the race in which this type is found (in this case hyena). -->
	<race>dsg_dragon</race>
	
	<!-- The name that will be used when referring to transformations related to this type (such as when changing body parts in the self-TF menu). -->
	<transformationName><![CDATA[крылатый дракон]]></transformationName>
	
	<!-- The id of the material covering this arm.
	The id will typically take the form of 'innoxia_hyena_fur'.
	Hard-coded values can be found here: https://github.com/Innoxia/liliths-throne-public/blob/dev/src/com/lilithsthrone/game/character/body/coverings/BodyCoveringType.java -->
	<coveringType>dsg_dragon_scales</coveringType>
	
	<!-- Whether this arm type grants the ability to fly. -->
	<allowsFlight>true</allowsFlight>
	
	<!-- Tags which are associated with this arm type.
	You should most likely only be using the 'arms' tags for your arm type, which are: ARM_STANDARD, ARM_WINGS, ARM_WINGS_FEATHERED, ARM_WINGS_LEATHERY.
	You should use either 'ARM_STANDARD' or 'ARM_WINGS', but not both.
	If you use 'ARM_WINGS', then you should also define either 'ARM_WINGS_FEATHERED' or 'ARM_WINGS_LEATHERY'.
	Values can be found here: https://github.com/Innoxia/liliths-throne-public/blob/dev/src/com/lilithsthrone/game/character/body/tags/BodyPartTag.java -->
	<tags>
		<tag>ARM_WINGS</tag>
		<tag>ARM_WINGS_LEATHERY</tag>
	</tags>
	
	<!-- The singular and plural name of this arm type.
	These should be left as 'arm' and 'arms' for standard arm types, and changed to 'wing' and 'wings' if your arm type are wings (such as those found on harpies or bat-morphs). -->
	<name><![CDATA[крыло]]></name>
	<namePlural><![CDATA[крылья]]></namePlural> 
	
	<!-- The descriptors which should be drawn upon when describing a masculine character's arm of this type.
	Can be left blank. -->
	<descriptorsMasculine>
		<descriptor>scaly</descriptor>
		<descriptor>scale-coated</descriptor>
	</descriptorsMasculine>
	<!-- Same as above, but for feminine characters. -->
	<descriptorsFeminine>
		<descriptor>scaly</descriptor>
		<descriptor>scale-coated</descriptor>
	</descriptorsFeminine>
	
	<!-- Same naming formats as those for the arm type above, but these describe the arm's hands: -->
	<handName><![CDATA[кисть]]></handName>
	<handNamePlural><![CDATA[кисти]]></handNamePlural>
	<handDescriptorsMasculine>
		<descriptor>dragon-like</descriptor>
		<descriptor>scaly</descriptor>
	</handDescriptorsMasculine>
	<handDescriptorsFeminine>
		<descriptor>soft</descriptor>
		<descriptor>feminine</descriptor>
		<descriptor>dragon-like</descriptor>
		<descriptor>scaly</descriptor>
	</handDescriptorsFeminine>
	
	<!-- Same naming formats as those for the arm type above, but these describe the arm's fingers: -->
	<fingerName><![CDATA[палец]]></fingerName>
	<fingerNamePlural><![CDATA[пальцы]]></fingerNamePlural>
	<fingerDescriptorsMasculine>
		<descriptor>talon-tipped</descriptor>
		<descriptor>dragon-like</descriptor>
	</fingerDescriptorsMasculine>
	<fingerDescriptorsFeminine>
		<descriptor>soft</descriptor>
		<descriptor>feminine</descriptor>
		<descriptor>talon-tipped</descriptor>
		<descriptor>dragon-like</descriptor>
	</fingerDescriptorsFeminine>
	
	<!-- The description which is shown when a character transforms to obtain this arm type.
	This description immediately follows a brief description of the arm type beginning to transform. -->
	<transformationDescription><![CDATA[Буквально за считанные мгновения их покрывает слой [npc.armFullDescription], и, начиная с [npc.her] рук, [npc.she] [npc.verb(watch)] как [npc.her] пальцы сужаются и становятся всё длиннее и длиннее, пока между ними нарастает плотная кожаная перепонка. [npc.She] [npc.verb(cry)] от испуга, когда [npc.she] [npc.verb(feel)], как [npc.her] кости переламываются, принимая новую форму, и на [npc.her] глазах [npc.her] руки и предплечья полностью превращаются в [style.boldDragon(огромные драконьи крылья)]. Там, где раньше были [npc.her] руки, два [npc.her] пальца уменьшились, став средним суставом [npc.her] новых конечностей, снабженных двумя маленькими указательными пальцами и противопоставленным большим пальцем, каждый из которых увенчан острым когтем. Там, где [npc.her] плечи соединяются с [npc.her] новыми крыльями у [npc.her] плеча, её новая чешуя плавно переходит в [npc.skin], покрывающую остальную часть [npc.her] торса.
<br/>Когда трансформация завершается, [npc.nameIsFull] остаётся с огромными [style.boldDragon(драконьими крыльями)] вместо рук, которые [npc.materialDescriptor] [npc.armFullDescription].]]></transformationDescription>
	
	<!-- How these arms are described in a character's description page. -->
	<bodyDescription><![CDATA[
	Вместо рук и кистей у [npc.she] [npc.has] [npc.armRows] огромные драконьи крылья, которые [npc.materialCompositionDescriptor] [npc.armFullDescription(true)].
	#IF(!npc.isFeral())
	 [npc.Her] кисти состоят из двух указательных пальцев и большого пальца, каждый из которых увенчан острым когтем. Хотя они чуть менее ловкие, чем пятипалая кисть, [npc.sheIs] всё же может использовать их для захвата, подобного руке.
	#ENDIF
	]]></bodyDescription>
	
</arm>
