			<response>				
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[Сразиться]]></responseTitle>
				<responseTooltip><![CDATA[Никто, кто одет подобным образом, не сможет тебя одолеть!]]></responseTooltip>
				<colour><![CDATA[GENERIC_COMBAT]]></colour>
				<nextDialogue/>
				<secondsPassed minutes="true"><![CDATA[1]]></secondsPassed>
