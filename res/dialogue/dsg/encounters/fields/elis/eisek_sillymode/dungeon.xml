					<nextDialoguePlayerDefeat><![CDATA[dsg_encounters_fields_elis_eisek_sillymode_dungeon_combat_lost]]></nextDialoguePlayerDefeat>
					<allies/>
					<enemies>
						<enemy leader="true"><![CDATA[dsg_larpattacker]]></enemy>
					</enemies>
					<openingDescriptions>
						<combatant id="dsg_larpattacker"><![CDATA[[dsg_larpattacker.speech(Ты выглядишь как чертовски вкусный источник опыта!)] [dsg_larpattacker.name] выкрикивает.]]></combatant>
					</openingDescriptions>
					<escapeBlocked><![CDATA[true]]></escapeBlocked>
				</combatVariables>
			</response>
		</responses>
