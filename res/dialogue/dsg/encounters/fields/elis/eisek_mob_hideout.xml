					[#flags.setFlag(FLAG_dsg_elis_eisek_mob_quest_persuade, true)]
					[#game.appendToTextEndStringBuilder(pc.setQuestProgress(QUEST_LINE_SIDE_EISEK_MOB, QUEST_EISEK_MOB_QUEST_STAGE_THREE))]
