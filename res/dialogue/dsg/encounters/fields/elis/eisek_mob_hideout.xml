				<index><![CDATA[5]]></index>
				<responseTitle><![CDATA[Запугать?]]></responseTitle>
				<responseTooltip><![CDATA[Они оставят Эйзека в покое, или же...]]></responseTooltip>
				<colour><![CDATA[GENERIC_BAD]]></colour>
				<nextDialogue><![CDATA[dsg_encounters_fields_elis_eisek_mob_hideout_intimidate_fail]]></nextDialogue>
				<secondsPassed/>
