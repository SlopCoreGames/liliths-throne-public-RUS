	<scene id ="poster">
		<author><![CDATA[DSG]]></author>
		<title><![CDATA[Плакат с драконом...]]></title>
		<tooltip/>	
		<preParsingEffects/>
		<content folderPath="txt/dsg/encounters/fields/elis/eisek_mob_hideout">POSTER</content>		
		<secondsPassed minutes="false"><![CDATA[30]]></secondsPassed>
		<continuesDialogue><![CDATA[false]]></continuesDialogue>	
		<travelDisabled><![CDATA[true]]></travelDisabled>	
		<inventoryDisabled><![CDATA[true]]></inventoryDisabled>	
		<regenerationDisabled><![CDATA[false]]></regenerationDisabled>
		<responseTabs/>
		<responses>		
			<response>	
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[Противостоять банде]]></responseTitle>
				<!-- TODO Add seduction route conditional check: && !pc.isSpellSchoolSpecialAbilityUnlocked(SPELL_SCHOOL_ARCANE) -->
				<responseTooltip><![CDATA[
					Следуй указаниям на плакате и найди банду, которая терроризирует Эйзека.
					#IF(flags.getSavedLong("elis_eisek_talk_score") >= 4)
						<br/>[style.colourGood(Поскольку ты провел немало времени, узнавая Эйзека, ты думаешь, что сможешь убедить банду оставить его в покое.)]
					#ELSE
						<br/>[style.colourBad(Ты не так уж хорошо знаешь Эйзека, поэтому, скорее всего, придется действовать силой. И результат может ему не слишком понравиться.)]
						#IF(pc.getAttributeValue(ATTRIBUTE_MAJOR_PHYSIQUE) < 30
							&& pc.getAttributeValue(ATTRIBUTE_MAJOR_ARCANE) < 30)
							<br/>[style.colourTerrible(В твоем нынешнем состоянии дела, скорее всего, пойдут довольно плохо...)]
						#ENDIF
					#ENDIF
				]]></responseTooltip>
				<colour><![CDATA[TEXT]]></colour>
				<nextDialogue stripContent="false"><![CDATA[dsg_encounters_fields_elis_eisek_mob_hideout_confront]]></nextDialogue>
				<secondsPassed/>
				<effects><![CDATA[
					[#game.appendToTextEndStringBuilder(pc.setQuestProgress(QUEST_LINE_SIDE_EISEK_MOB, QUEST_EISEK_MOB_QUEST_STAGE_TWO))]
				]]></effects>
			</response>
			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[2]]></index>
				<responseTitle><![CDATA[Выбросить плакат]]></responseTitle>
				<responseTooltip><![CDATA[Ты не хочешь сейчас связываться с бандой, но можешь сделать доброе дело и сорвать плакат со стены.]]></responseTooltip>
				<nextDialogue><![CDATA[dsg_encounters_fields_elis_eisek_mob_hideout_discard_poster]]></nextDialogue>
				<secondsPassed/>
				<effects/>
			</response>
		</responses>
	</scene>
	
