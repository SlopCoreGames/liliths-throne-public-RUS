				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[Продолжить]]></responseTitle>
				<responseTooltip><![CDATA[
					По крайней мере, ты цел(а).
				]]></responseTooltip>
				<nextDialogue><![CDATA[
					default
				]]></nextDialogue>
				<effects/>
			</response>
		</responses>
	</scene>
	
