            </response>

            <response>
                <responseTabIndex><![CDATA[0]]></responseTabIndex>
                <index><![CDATA[2]]></index>
                <responseTitle><![CDATA[Отказаться]]></responseTitle>
                <responseTooltip><![CDATA[
					#IF(pc.getMoney()<10000)
						У тебя просто нет возможности выложить такую сумму за секс с Ангелом, так что остается только принять ее предложение...
					#ELSE
						Тебе не хочется тратить столько денег на секс с Ангелом, поэтому ты решаешь отклонить ее предложение...
					#ENDIF
				]]></responseTooltip>
                <nextDialogue><![CDATA[acexp_dominion_angel_office_leave]]></nextDialogue>
                <effects><![CDATA[
					[#game.appendToTextStartStringBuilder(game.parseFromFile('txt/acexp/dominion/angel_office', 'LEAVE'))]
					[#pc.setNearestLocation(PLACE_TYPE_ANGELS_KISS_CORRIDOR)]
				]]></effects>
            </response>
        </responses>
    </scene>

