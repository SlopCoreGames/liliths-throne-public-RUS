			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[Наедине]]></responseTitle>
				<responseTooltip><![CDATA[Внезапно оказавшись в одиночестве среди окутанных туманом пейзажей, тебе нужно найти огни, о которых упоминал Мераксис, чтобы разрушить заклинание ёко.]]></responseTooltip>
