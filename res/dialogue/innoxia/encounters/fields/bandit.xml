		<secondsPassed minutes="true"><![CDATA[5]]></secondsPassed>
		<continuesDialogue>false</continuesDialogue>
		<travelDisabled>true</travelDisabled>
		<responses>
			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<colour><![CDATA[GENERIC_NPC_REMOVAL]]></colour>
				<responseTitle><![CDATA[Продолжить]]></responseTitle>
				<responseTooltip><![CDATA[
					Когда бандит ушел, тебе остается только продолжить свой путь...
					<br/>[style.italicsBad(Бандит навсегда исчезнет из игры.)]
				]]></responseTooltip>
				<nextDialogue><![CDATA[default]]></nextDialogue>
				<secondsPassed minutes="true"><![CDATA[5]]></secondsPassed>
				<effects><![CDATA[
					[#game.banishNPC(attacker)]
				]]></effects>
			</response>
		</responses>
	</scene>
	
	<!-- Won combat: -->
	
