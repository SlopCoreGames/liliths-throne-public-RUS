<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<dialogueNodes>

	<!-- ELIS SCENES: -->
	
    <!-- Place type id: innoxia_fields_elis_town_abandoned_bakery -->
	<scene id="exterior">
		<content folderPath="txt/places/fields/elis/abandoned_bakery">EXTERIOR</content>
		<secondsPassed><![CDATA[15]]></secondsPassed>
		<continuesDialogue>false</continuesDialogue>
		<travelDisabled>false</travelDisabled>
		<responses>
			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[Исследовать]]></responseTitle>
				<responseTooltip><![CDATA[
					#IF(ENCOUNTER_innoxia_elis_alleyway.isAnyEncounterAvailable())
						Потратить время на осмотр окрестных переулков, чтобы попытаться найти что-нибудь интересное.
					#ELSE
						У тебя такое чувство, что в этих переулках вряд ли найдется что-то стоящее, так что нет смысла тратить время на поиски...
					#ENDIF
				]]></responseTooltip>
				<nextDialogue><![CDATA[
					#IF(ENCOUNTER_innoxia_elis_alleyway.isAnyEncounterAvailable())
