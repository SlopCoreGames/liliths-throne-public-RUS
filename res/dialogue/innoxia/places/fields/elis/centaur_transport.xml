<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<dialogueNodes>

	<scene id="exterior">
		<content folderPath="txt/places/fields/elis/centaur_transport">EXTERIOR</content>
		<secondsPassed minutes="true"><![CDATA[2]]></secondsPassed>
		<continuesDialogue>false</continuesDialogue>
		<travelDisabled>false</travelDisabled>
		<responses>
			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[Сарай]]></responseTitle>
				<responseTooltip><![CDATA[
					#IF(!flags.hasFlag(FLAG_innoxia_centaur_transport_introduced))
						Похоже, сарай совсем пуст. Тебе здесь делать нечего, кроме как идти дальше.
					#ELSEIF(flags.hasFlag(FLAG_innoxia_centaur_transport_setup_in_progress))
						Раз Астрапи сообщила, что она и Вронти больше не будут возить пассажиров сегодня, тебе придется вернуться завтра, если ты хочешь воспользоваться их услугами.
					#ELSE
						Подойти к сараю и попытаться найти Астрапи или Вронти.
					#ENDIF
				]]></responseTooltip>
				<nextDialogue><![CDATA[
					#IF(!flags.hasFlag(FLAG_innoxia_centaur_transport_introduced) || flags.hasFlag(FLAG_innoxia_centaur_transport_setup_in_progress))
						null
					#ELSE
						innoxia_places_fields_elis_centaur_transport_approach
					#ENDIF
				]]></nextDialogue>
			</response>
		</responses>
	</scene>
	
	<scene id="approach">
		<content folderPath="txt/places/fields/elis/centaur_transport">APPROACH</content>
		<secondsPassed minutes="true"><![CDATA[2]]></secondsPassed>
		<continuesDialogue>false</continuesDialogue>
		<travelDisabled>true</travelDisabled>
		<responses>
			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[Внутри]]></responseTitle>
				<responseTooltip><![CDATA[
					#IF(game.isHourBetween(5.75, 15))
						Сарай открыт в период [style.italicsMinorGood([units.time(5.75)]-[units.time(15)])], так что ты можешь [pc.step] внутрь целого здания и, возможно, найти Астрапи или Вронти.
					#ELSE
						Сарай открыт в период [style.italicsMinorBad([units.time(5.75)]-[units.time(15)])], а сейчас он пустует. Чтобы снова встретить Астрапи или Вронти, тебе придется вернуться в часы работы.
					#ENDIF
				]]></responseTooltip>
				<nextDialogue><![CDATA[
					#IF(game.isHourBetween(5.75, 15))
						innoxia_places_fields_elis_centaur_transport_approach_inside
					#ELSE
						null
					#ENDIF
				]]></nextDialogue>
			</response>
			<response>
				<availabilityConditional><![CDATA[
					[#!game.isHourBetween(5.75, 15)]
				]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[2]]></index>
				<responseTitle><![CDATA[Подождать и войти]]></responseTitle>
				<responseTooltip><![CDATA[Поскольку сейчас сарай закрыт, ты можешь подождать здесь до [units.time(5.75)], чтобы он открылся, а затем зайти внутрь, если захочешь...]]></responseTooltip>
				<nextDialogue><![CDATA[innoxia_places_fields_elis_centaur_transport_approach_inside]]></nextDialogue>
				<secondsPassed minutes="true"><![CDATA[
					[#game.getMinutesUntilTimeInMinutes(5.75*60)]
				]]></secondsPassed>
				<!-- Manually set Vronti here in effects as preParsing is called after time passed -->
				<effects><![CDATA[
					[#game.appendToTextStartStringBuilder(game.parseFromFile('txt/places/fields/elis/centaur_transport', 'APPROACH_WAIT'))]
					[#vronti.setLocation(pc, false)]
				]]></effects>
			</response>
			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[0]]></index>
				<responseTitle><![CDATA[Уйти]]></responseTitle>
				<responseTooltip><![CDATA[
					#IF(game.isHourBetween(5.75, 15))
						Решить не заходить в здание.
					#ELSE
						Так как сарай сейчас закрыт, тебе здесь делать нечего. Чтобы снова встретить Астрапи или Вронти, придется вернуться в период [style.italicsMinorBad([units.time(5.75)]-[units.time(15)])].
					#ENDIF
				]]></responseTooltip>
				<nextDialogue><![CDATA[default]]></nextDialogue>
				<effects><![CDATA[
					[#game.appendToTextStartStringBuilder(game.parseFromFile('txt/places/fields/elis/centaur_transport', 'LEAVE'))]
				]]></effects>
			</response>
		</responses>
	</scene>
	
	<scene id="approach_inside">
		<!-- If time is:
			05:45-6:00 - Vronti waiting there
			08:45-9:00 - Astrapi waiting there
			11:45-12:00 - Vronti waiting there
			14:45-15:00 - Astrapi waiting there
			-->
		<preParsingEffects><![CDATA[
			#IF(game.isHourBetween(5.75, 6) || game.isHourBetween(11.75, 12))
				[#vronti.setLocation(pc, false)]
			#ELSEIF(game.isHourBetween(8.75, 9) || game.isHourBetween(14.75, 15))
				[#astrapi.setLocation(pc, false)]
			#ENDIF
		]]></preParsingEffects>
		<content folderPath="txt/places/fields/elis/centaur_transport">APPROACH_INSIDE</content>
		<secondsPassed minutes="true"><![CDATA[5]]></secondsPassed>
		<continuesDialogue>true</continuesDialogue>
		<travelDisabled>true</travelDisabled>
		<responses>
			<response>
				<availabilityConditional><![CDATA[
					[#!game.getCharactersPresent().contains(astrapi) && !game.getCharactersPresent().contains(vronti)]
				]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[Ждать]]></responseTitle>
				<responseTooltip><![CDATA[Раз ни Астрапи, ни Вронти сейчас нет на месте, тебе придется ждать следующего рейса, если ты хочешь отправиться в Элис.]]></responseTooltip>
				<nextDialogue><![CDATA[innoxia_places_fields_elis_centaur_transport_approach_inside]]></nextDialogue>
				<secondsPassed minutes="true"><![CDATA[
					#IF(game.getHourOfDay()>12)
						[#game.getMinutesUntilTimeInMinutes(14.75*60)]
					#ELSEIF(game.getHourOfDay()>9)
						[#game.getMinutesUntilTimeInMinutes(11.75*60)]
					#ELSEIF(game.getHourOfDay()>6)
						[#game.getMinutesUntilTimeInMinutes(8.75*60)]
					#ENDIF
				]]></secondsPassed>
				<!-- Duplicate effects as preParsing is called after time passed, so these effects aren't applied unless put here -->
				<effects><![CDATA[
					#IF(game.getHourOfDay()>12)
						[#vronti.setLocation(pc, false)]
					#ELSEIF(game.getHourOfDay()>9)
						[#astrapi.setLocation(pc, false)]
					#ELSEIF(game.getHourOfDay()>6)
						[#vronti.setLocation(pc, false)]
					#ELSE
						[#astrapi.setLocation(pc, false)]
					#ENDIF
				]]></effects>
			</response>
			<response>
				<availabilityConditional><![CDATA[
					[#game.getCharactersPresent().contains(astrapi) || game.getCharactersPresent().contains(vronti)]
				]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[
					#IF(pc.getMoney()>=250)
						Dominion [style.moneyFormat(250, span)]
					#ELSE
						Dominion [style.moneyFormatUncoloured(250, span)]
					#ENDIF
				]]></responseTitle>
				<responseTooltip><![CDATA[
					#IF(pc.getMoney()>=250)
						#IF(game.getCharactersPresent().contains(astrapi))
							Принять предложение Астрапи, чтобы она прямо сейчас отвезла тебя в Dominion.
						#ELSE
							Принять предложение Вронти, чтобы он прямо сейчас отвез тебя в Dominion.
						#ENDIF
					#ELSE
							У тебя недостаточно денег, чтобы доехать до Dominion!
					#ENDIF
				]]></responseTooltip>
				<nextDialogue><![CDATA[
					#IF(pc.getMoney()>=250)
						#IF(game.getCharactersPresent().contains(astrapi))
							innoxia_places_fields_centaur_transport_astrapi_start
						#ELSE
							innoxia_places_fields_centaur_transport_vronti_start
						#ENDIF
					#ELSE
						null
					#ENDIF
				]]></nextDialogue>
				<effects><![CDATA[
					#IF(game.getCharactersPresent().contains(astrapi) && astrapi.isVisiblyPregnant())
						[#astrapi.setCharacterReactedToPregnancy(pc, true)]
					#ENDIF
					[#flags.setFlag(FLAG_innoxia_centaur_travel_to_elis, false)]
				]]></effects>
			</response>
			<response>
				<availabilityConditional><![CDATA[
					[#game.getCharactersPresent().contains(astrapi) || game.getCharactersPresent().contains(vronti)]
				]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[2]]></index>
				<responseTitle><![CDATA[Отклонить]]></responseTitle>
				<responseTooltip><![CDATA[
					#IF(game.getCharactersPresent().contains(astrapi))
							Сказать Астрапи, что ты не хочешь ехать в Dominion прямо сейчас, и выйти из амбара.
					#ELSE
							Сказать Вронти, что ты не хочешь ехать в Dominion прямо сейчас, и выйти из амбара.
					#ENDIF
				]]></responseTooltip>
				<nextDialogue><![CDATA[default]]></nextDialogue>
				<effects><![CDATA[
					#IF(game.getCharactersPresent().contains(astrapi) && astrapi.isVisiblyPregnant())
						[#astrapi.setCharacterReactedToPregnancy(pc, true)]
					#ENDIF
					[#game.appendToTextStartStringBuilder(game.parseFromFile('txt/places/fields/elis/centaur_transport', 'LEAVE_BARN'))]
					[#astrapi.returnToHome()]
					[#vronti.returnToHome()]
				]]></effects>
			</response>
		</responses>
	</scene>
	
</dialogueNodes>
