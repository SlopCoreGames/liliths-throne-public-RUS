	<!-- Place type id: innoxia_fields_elis_town_hall_f1_minotallys_office -->
	<scene id="minotallys_office">
		<author><![CDATA[Innoxia]]></author>
		<content folderPath="txt/places/fields/elis/town_hall_f1">MINOTALLYS_OFFICE</content>
		<secondsPassed><![CDATA[10]]></secondsPassed>
		<continuesDialogue>false</continuesDialogue>
		<travelDisabled>false</travelDisabled>
		<responses>
			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[Постучать]]></responseTitle>
				<responseTooltip><![CDATA[
					#IF(game.getCharactersPresent().contains(minotallys))
						Постучи в дверь, чтобы привлечь внимание Миноталис.
					#ELSE
						Миноталис сейчас нет в кабинете...
					#ENDIF
				]]></responseTooltip>
				<nextDialogue><![CDATA[
					#IF(game.getCharactersPresent().contains(minotallys))
						innoxia_places_fields_elis_town_hall_f1_minotallys_office_start
					#ELSE
						null
					#ENDIF
				]]></nextDialogue>
				<effects><![CDATA[
					[#flags.setFlag(FLAG_innoxia_minotallys_talk_milk, false)]
				]]></effects>
			</response>
		</responses>
	</scene>
	
	<scene id="minotallys_office_start">
		<author><![CDATA[Innoxia]]></author>
		<content folderPath="txt/places/fields/elis/town_hall_f1">MINOTALLYS_OFFICE_START</content>
		<secondsPassed minutes="true"><![CDATA[2]]></secondsPassed>
		<continuesDialogue>false</continuesDialogue>
		<travelDisabled>true</travelDisabled>
		<responses>
			<!-- History: -->
			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[1]]></index>
				<responseTitle><![CDATA[История]]></responseTitle>
				<responseTooltip><![CDATA[
					#IF(flags.hasFlag(FLAG_innoxia_minotallys_talk_history))
						Ты уже потратил сегодня время, расспрашивая Миноталис о том, как она правила Элисом...
					#ELSE
						Расспросить Миноталис о том, как она правила Элисом.
					#ENDIF
				]]></responseTooltip>
				<nextDialogue><![CDATA[
					#IF(flags.hasFlag(FLAG_innoxia_minotallys_talk_history))
						null
					#ELSE
						innoxia_places_fields_elis_town_hall_f1_minotallys_office_talking
					#ENDIF
				]]></nextDialogue>
				<effects><![CDATA[
					[#game.appendToTextStartStringBuilder(game.parseFromFile('txt/places/fields/elis/town_hall_f1', 'MINOTALLYS_OFFICE_TALK_HISTORY'))]
					[#flags.setFlag(FLAG_innoxia_minotallys_talk_history, true)]
					#IF(minotallys.getAffection(pc)<40)
						[#game.appendToTextEndStringBuilder(minotallys.incrementAffection(pc, 2))]
					#ENDIF
				]]></effects>
			</response>
			<!-- Arion: -->
			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[2]]></index>
				<responseTitle><![CDATA[Арион]]></responseTitle>
				<responseTooltip><![CDATA[
					#IF(flags.hasFlag(FLAG_innoxia_minotallys_talk_arion))
						Ты уже потратил сегодня время, расспрашивая Миноталис об их отношениях с Арионом...
					#ELSE
						Расспросить Миноталис об их отношениях с Арионом.
					#ENDIF
				]]></responseTooltip>
				<nextDialogue><![CDATA[
					#IF(flags.hasFlag(FLAG_innoxia_minotallys_talk_arion))
						null
					#ELSE
						innoxia_places_fields_elis_town_hall_f1_minotallys_office_talking
					#ENDIF
				]]></nextDialogue>
				<effects><![CDATA[
					[#game.appendToTextStartStringBuilder(game.parseFromFile('txt/places/fields/elis/town_hall_f1', 'MINOTALLYS_OFFICE_TALK_ARION'))]
					[#flags.setFlag(FLAG_innoxia_minotallys_talk_arion, true)]
					#IF(minotallys.getAffection(pc)<40)
						[#game.appendToTextEndStringBuilder(minotallys.incrementAffection(pc, 2))]
					#ENDIF
				]]></effects>
			</response>
			<!-- Work: -->
			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[3]]></index>
				<responseTitle><![CDATA[Работать]]></responseTitle>
				<responseTooltip><![CDATA[
					#IF(flags.hasFlag(FLAG_innoxia_minotallys_talk_work))
						Ты уже потратил сегодня время, расспрашивая Миноталис о характере её работы...
					#ELSE
						Расспросить Миноталис о характере её работы.
					#ENDIF
				]]></responseTooltip>
				<nextDialogue><![CDATA[
					#IF(flags.hasFlag(FLAG_innoxia_minotallys_talk_work))
						null
					#ELSE
						innoxia_places_fields_elis_town_hall_f1_minotallys_office_talking
					#ENDIF
				]]></nextDialogue>
				<effects><![CDATA[
					[#game.appendToTextStartStringBuilder(game.parseFromFile('txt/places/fields/elis/town_hall_f1', 'MINOTALLYS_OFFICE_TALK_WORK'))]
					[#flags.setFlag(FLAG_innoxia_minotallys_talk_work, true)]
					#IF(minotallys.getAffection(pc)<40)
						[#game.appendToTextEndStringBuilder(minotallys.incrementAffection(pc, 2))]
					#ENDIF
				]]></effects>
			</response>
			<!-- Lilith: -->
			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[4]]></index>
				<responseTitle><![CDATA[Lilith]]></responseTitle>
				<responseTooltip><![CDATA[
					#IF(flags.hasFlag(FLAG_innoxia_minotallys_talk_lilith))
						Ты уже спрашивал сегодня Миноталлис о её мнении насчет Lilith...
					#ELSE
						Спросить Миноталлис о её мнении насчет Lilith.
					#ENDIF
				]]></responseTooltip>
				<nextDialogue><![CDATA[
					#IF(flags.hasFlag(FLAG_innoxia_minotallys_talk_lilith))
						null
					#ELSE
						innoxia_places_fields_elis_town_hall_f1_minotallys_office_talking
					#ENDIF
				]]></nextDialogue>
				<effects><![CDATA[
					[#game.appendToTextStartStringBuilder(game.parseFromFile('txt/places/fields/elis/town_hall_f1', 'MINOTALLYS_OFFICE_TALK_LILITH'))]
					[#flags.setFlag(FLAG_innoxia_minotallys_talk_lilith, true)]
					#IF(minotallys.getAffection(pc)<40)
						[#game.appendToTextEndStringBuilder(minotallys.incrementAffection(pc, 2))]
					#ENDIF
				]]></effects>
			</response>
			<!-- Drink milk: -->
			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[5]]></index>
				<responseTitle><![CDATA[Выпить молока]]></responseTitle>
				<responseTooltip><![CDATA[
					#IF(flags.hasFlag(FLAG_innoxia_minotallys_talk_milk))
						Ты уже выпил свою ежедневную порцию молока Миноталлис...
					#ELSE
						Принять предложение Миноталлис и выпить стакан того, что явно является её грудным молоком.
					#ENDIF
				]]></responseTooltip>
				<nextDialogue><![CDATA[
					#IF(flags.hasFlag(FLAG_innoxia_minotallys_talk_milk))
						null
					#ELSE
						innoxia_places_fields_elis_town_hall_f1_minotallys_office_talking
					#ENDIF
				]]></nextDialogue>
				<effects><![CDATA[
					[#game.appendToTextStartStringBuilder(game.parseFromFile('txt/places/fields/elis/town_hall_f1', 'MINOTALLYS_OFFICE_TALK_MILK'))]
					[#flags.setFlag(FLAG_innoxia_minotallys_talk_milk, true)]
					#IF(minotallys.getAffection(pc)<60)
						[#game.appendToTextEndStringBuilder(minotallys.incrementAffection(pc, 5))]
					#ENDIF
				]]></effects>
			</response>
			<!-- Quest: -->
			<response>
				<availabilityConditional><![CDATA[[#pc.isQuestProgressGreaterThan(QUEST_LINE_MAIN, QUEST_MAIN_3_E_THEMISCYRA_ATTACK)]]]></availabilityConditional>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[6]]></index>
				<responseTitle><![CDATA[Помощь SWORD]]></responseTitle>
				<responseTooltip><![CDATA[
					#IF(pc.getQuest(QUEST_LINE_MAIN)==QUEST_MAIN_3_I_ELIS_DEFENCE_PLAN)
						Сказать Миноталлис и Ариону, что тебе помогают Enforcer из SWORD.
					#ELSE
						У тебя еще нет помощи Enforcer из SWORD...
					#ENDIF
				]]></responseTooltip>
				<nextDialogue><![CDATA[
					#IF(pc.getQuest(QUEST_LINE_MAIN)==QUEST_MAIN_3_I_ELIS_DEFENCE_PLAN)
						innoxia_quests_main_elisDefenceMeeting_start
					#ELSE
						null
					#ENDIF
				]]></nextDialogue>
			</response>
			<!-- Leave: -->
			<response>
				<responseTabIndex><![CDATA[0]]></responseTabIndex>
				<index><![CDATA[0]]></index>
				<responseTitle><![CDATA[Уйти]]></responseTitle>
				<responseTooltip><![CDATA[Попрощаться и выйти из кабинета Миноталлис.]]></responseTooltip>
				<nextDialogue><![CDATA[innoxia_places_fields_elis_town_hall_f1_corridor]]></nextDialogue>
				<effects><![CDATA[
					[#pc.setNearestLocation(WORLD_TYPE_innoxia_fields_elis_town_hall_f1, PLACE_TYPE_innoxia_fields_elis_town_hall_f1_corridor)]
					[#game.appendToTextStartStringBuilder(game.parseFromFile('txt/places/fields/elis/town_hall_f1', 'MINOTALLYS_OFFICE_EXIT'))]
				]]></effects>
			</response>
		</responses>
	</scene>
	
