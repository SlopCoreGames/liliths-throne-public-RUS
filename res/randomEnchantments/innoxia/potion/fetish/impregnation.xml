<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<potionEnchantment>
	<positiveEnchantment><![CDATA[false]]></positiveEnchantment>
	
	<spawnWeighting><![CDATA[
		#IF(npc.hasPenis() && !npc.hasFetish(FETISH_IMPREGNATION))
			100
		#ELSE
			0
		#ENDIF
	]]></spawnWeighting>
	
	<conditionalPreParsing/>
	
	<name defaultPrepend="true"><![CDATA[Отец]]></name>
	
	<applicationSpeechStart replaceAll="false"><![CDATA[
		Нет ничего лучше, чем забеременеть какой-нибудь шлюхой!
	]]></applicationSpeechStart>
	
	<applicationSpeechEnd replaceAll="false"><![CDATA[
		А теперь иди и оплодотвори кого-нибудь!
	]]></applicationSpeechEnd>
	
	<potionEffects>
		<conditional/>
		<effect><![CDATA[
			[#npc.addFetish(FETISH_IMPREGNATION)]
		]]></effect>
	</potionEffects>
	
</potionEnchantment>
