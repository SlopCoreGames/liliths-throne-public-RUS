<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<potionEnchantment>
	<positiveEnchantment><![CDATA[false]]></positiveEnchantment>
	
	<spawnWeighting><![CDATA[
		#IF(!npc.isAbleToHaveRaceTransformed())
			0
		#ELSE
			100
		#ENDIF
	]]></spawnWeighting>
	
	<conditionalPreParsing replaceAll="false"><![CDATA[
		[#flags.setObject('potionSubspecies', util.static.randomItemFrom(subspecies.static.getCommonSubspecies(util.static.newArrayListOfValues(npc.getSubspecies()))))]
	]]></conditionalPreParsing>
	
	<name defaultPrepend="true"><![CDATA[Случайная трансформация]]></name>
	
	<applicationSpeechStart replaceAll="false"><![CDATA[
		Давай бросим кости и посмотрим, какая часть твоего тела изменится!
	]]></applicationSpeechStart>
	
	<applicationSpeechEnd/>
	
	<potionEffects>
		<conditional><![CDATA[
			[#!npc.isAbleToHaveRaceTransformed()]
		]]></conditional>
		<effect><![CDATA[
			<p style='text-align:center;'>
				[style.italicsDisabled(Ничего не происходит, так как раса [npc.namePos] не поддается трансформации...)]
			</p>
		]]></effect>
	</potionEffects>
	
	<potionEffects>
		<conditional><![CDATA[
			[#npc.isAbleToHaveRaceTransformed()]
		]]></conditional>
		<effect><![CDATA[
			[#npc.applyRandomTransformation(flags.getObject('potionSubspecies'))]
		]]></effect>
	</potionEffects>
	
</potionEnchantment>
