<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<item>
	<coreAttributes>
		<value>250</value> 
		<determiner><![CDATA[a tin of]]></determiner>
		<name><![CDATA[Кофейное зерно в шоколаде]]></name>
		<namePlural pluralByDefault="true"><![CDATA[Кофейные зерна в шоколаде]]></namePlural>
		<description><![CDATA[Металлическая жестяная банка, наполненная несколькими десятками кофейных зерен, покрытых темным шоколадом. На одной стороне банки красуется изображение раскрасневшейся паучихи, подмигивающей зрителю, и предостережение: <i>'Осторожно! Чрезвычайно алкогольно для пауков!'</i>]]></description> 
		
		<useDescriptor>eat</useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>RARE</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="0" imageSize="70" target1='stroke="#000"' replacement1='stroke="#ff5555"' target2='#ff8080' replacement2='#ff5555'>res/race/charisma/spider/subspecies/icon.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="70">spider_chocolate_coated_cocoa_beans.svg</imageName>
		<imageName zLayer="3" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>charisma_spider_silk_white</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<potionDescriptor><![CDATA[spider]]></potionDescriptor>
		<associatedRace>charisma_spider</associatedRace>
		<enchantmentItemTypeId>ELIXIR</enchantmentItemTypeId>
		<enchantmentEffectId>RACE</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldGood(Восстанавливает)] 10% [style.boldHealth([#ATTRIBUTE_HEALTH_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[#ATTRIBUTE_MAJOR_PHYSIQUE.getFormattedValue(2)] к 'эффектам зелий']]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementHealth(npc.getAttributeValue(ATTRIBUTE_HEALTH_MAXIMUM)/10)]
			
			<p style='margin-bottom:0; padding-bottom:0;'>
				[npc.Name] [npc.verb(start)] чувствовать прилив сил...
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_MAJOR_PHYSIQUE, 2)]
		]]></applyEffects>
		
		<itemTags>
			<tag>FOOD</tag>
			<tag>RACIAL_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
			<tag>CAFFEINATED_040</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		[npc.Name] [npc.verb(take)] горсть шоколадных кофейных зерен и [npc.verb(crush)] их в [npc.her] [npc.mouth]. Не в силах сдержать [npc.herself], [npc.she] быстро [npc.verb(finish)] всю банку целиком.
		]]></selfUse>
		<otherUse><![CDATA[
		[npc.Name] [npc.verb(take)] горсть шоколадных кофейных зерен и [npc.verb(hold)] их перед [npc2.name], которая [npc.verb(crush)] их в [npc2.her] [npc2.mouth]. Не в силах сдержать [npc2.herself], [npc2.she] быстро [npc2.verb(finish)] всю банку целиком.
		]]></otherUse>
	</useDescriptions>

	
</item>
