<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<item>
	<coreAttributes>
		<authorTag><![CDATA[На кожуре едва заметен восковой штамп: «Выращено драконами из Фермерской гильдии DSG».]]></authorTag>
		<value>8</value>
		<determiner><![CDATA[some]]></determiner>
		<name><![CDATA[мандарины]]></name>
		<namePlural pluralByDefault="false"><![CDATA[мандарины]]></namePlural>
		<description><![CDATA[Зимний цитрусовый фрукт, который менее кислый, чем многие его более крупные сородичи. Кожура обладает глянцевым блеском, будто её отполировали.]]></description>
		<useDescriptor>eat</useDescriptor>
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		<rarity>UNCOMMON</rarity>
		
		<imageName>tangerines.svg</imageName>
		<colourPrimary>BASE_ORANGE</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<associatedRace/>
		<enchantmentItemTypeId/>
		<enchantmentEffectId/>
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldGood(Восстанавливает)] 5% [style.boldHealth([#ATTRIBUTE_HEALTH_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[style.boldGood(Увеличивает)] [style.boldPoison([#ATTRIBUTE_RESISTANCE_POISON.getName()])] на 5 на 90 минут.]]></line>
			<line><![CDATA[[style.colourBlueLight(Изменяет)] вкус всех жидкостей на [style.colourOrange(оранжевый)].]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementHealth(npc.getAttributeValue(ATTRIBUTE_HEALTH_MAXIMUM)/5)]
			#IF (npc.hasBreasts())
				[##npc.setMilkFlavour(FLUID_FLAVOUR_ORANGE)]
			#ENDIF
			#IF (npc.hasBreastsCrotch())
				[##npc.setMilkFlavour(FLUID_FLAVOUR_ORANGE)]
			#ENDIF
			#IF (npc.hasPenis())
				[##npc.setCumFlavour(FLUID_FLAVOUR_ORANGE)]
			#ENDIF
			#IF (npc.hasVagina())
				[##npc.setGirlcumFlavour(FLUID_FLAVOUR_ORANGE)]
			#ENDIF
			#IF (!npc.hasStatusEffect(SE_dsg_item_fruit_buff_plus))
				[##npc.addStatusEffect(SE_dsg_item_fruit_buff, 5400)]
			#ENDIF
			<p style='margin-bottom:0; padding-bottom:0;'>
				[npc.Name] [npc.verb(чувствуешь)] себя немного здоровее...
			</p>
		]]></applyEffects>
		
		<itemTags>
			<tag>SOLD_BY_EISEK</tag>
		</itemTags>
		
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
			[npc.Name] [npc.verb(находит)] мандарин удивительно легко очищаемым и [npc.verb(начинает)] есть его долька за долькой. Вскоре после этого он съедает его целиком...
		]]></selfUse>
		<otherUse><![CDATA[
			[npc.Name] [npc.verb(находит)] мандарин удивительно легко очищаемым и [npc.verb(начинает)] скармливать его [npc2.name] долька за долькой. Вскоре после этого он съедает его целиком...
		]]></otherUse>
	</useDescriptions>

	
</item>
