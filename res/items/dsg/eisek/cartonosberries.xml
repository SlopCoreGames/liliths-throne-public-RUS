<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<item>
	<coreAttributes>
		<authorTag><![CDATA[Под картонной коробкой едва заметно вытиснена надпись: «Выращено драконами Гильдии Фермеров DSG».]]></authorTag>
		<value>5</value>
		<determiner><![CDATA[a]]></determiner>
		<name><![CDATA[картонная упаковка клубники]]></name>
		<namePlural pluralByDefault="false"><![CDATA[картонные упаковки клубники]]></namePlural>
		<description><![CDATA[Упаковка ягод, собранных с домашней земляники. На солнце они излучают слабое, полупрозрачное сияние.]]></description>
		<useDescriptor>eat</useDescriptor>
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		<rarity>UNCOMMON</rarity>
		
		<imageName>cartonosberries.svg</imageName>
		<colourPrimary>BASE_CRIMSON</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<associatedRace/>
		<enchantmentItemTypeId/>
		<enchantmentEffectId/>
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldGood(Восстанавливает)] 5% [style.boldHealth([#ATTRIBUTE_HEALTH_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[style.boldGood(Увеличивает)] [style.boldPoison([#ATTRIBUTE_RESISTANCE_POISON.getName()])] на 7 единиц на 1 час.]]></line>
			<line><![CDATA[[style.colourBlueLight(Изменяет)] вкус всех жидкостей на [style.colourCrimson(клубничный)].]]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementHealth(npc.getAttributeValue(ATTRIBUTE_HEALTH_MAXIMUM)/5)]
			#IF (npc.hasBreasts())
				[##npc.setMilkFlavour(FLUID_FLAVOUR_STRAWBERRY)]
			#ENDIF
			#IF (npc.hasBreastsCrotch())
				[##npc.setMilkFlavour(FLUID_FLAVOUR_STRAWBERRY)]
			#ENDIF
			#IF (npc.hasPenis())
				[##npc.setCumFlavour(FLUID_FLAVOUR_STRAWBERRY)]
			#ENDIF
			#IF (npc.hasVagina())
				[##npc.setGirlcumFlavour(FLUID_FLAVOUR_STRAWBERRY)]
			#ENDIF
			#IF (!npc.hasStatusEffect(SE_dsg_item_fruit_buff_plus))
				[##npc.addStatusEffect(SE_dsg_item_fruit_buff, 3600)]
			#ENDIF
			<p style='margin-bottom:0; padding-bottom:0;'>
				[npc.Name] [npc.verb(чувствуешь)] себя немного здоровее...
			</p>
		]]></applyEffects>
		
		<itemTags>
			<tag>SOLD_BY_EISEK</tag>
		</itemTags>
		
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
			[npc.Name] осторожно [npc.verb(берет)] клубнику из упаковки и [npc.verb(начинает)] есть ее, но вскоре начинает [npc.verb(заталкивать)] ягоды прямо в [npc.her] рот. Вскоре упаковка пустеет...
		]]></selfUse>
		<otherUse><![CDATA[
			[npc.Name] осторожно [npc.verb(берет)] клубнику из упаковки, чтобы дать ее съесть [npc2.name], но вскоре [npc2.name] выхватывает всю упаковку у [npc.her] и начинает [npc2.verb(заталкивать)] ягоды в [npc.her] рот. Вскоре упаковка пустеет...
		]]></otherUse>
	</useDescriptions>

	
</item>
