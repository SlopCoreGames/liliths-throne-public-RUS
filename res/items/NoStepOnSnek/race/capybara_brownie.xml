<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<item>
	<coreAttributes>
		<value>25</value> 
		<determiner><![CDATA[a]]></determiner>
		<name><![CDATA[Шоколадный брауни]]></name>
		<namePlural pluralByDefault="false"><![CDATA[Шоколадные брауни]]></namePlural>
		<description><![CDATA[Маленькая картонная коробочка, в которой лежит аппетитный шоколадный брауни и небольшая керамическая тарелка для подачи. Вообще это популярное лакомство, но капибары каким-то образом стали неразрывно с ним связаны, хотя никто толком не знает почему.]]></description> 
		
		<useDescriptor>eat</useDescriptor>
		
		<sexUse>true</sexUse>
		<combatUseAllies>true</combatUseAllies>
		<combatUseEnemies>false</combatUseEnemies>
		<consumedOnUse>true</consumedOnUse>
		
		<rarity>RARE</rarity> 
		
		<imageName zLayer="0" imageRotation="0" imageSize="100">background_bottom.svg</imageName>
		<imageName zLayer="1" imageRotation="0" imageSize="90" target1='stroke="#000"' replacement1='stroke="#ff5555"' target2='#ff8080' replacement2='#ff5555'>res/race/NoStepOnSnek/capybara/subspecies/capybara.svg</imageName>
		<imageName zLayer="2" imageRotation="0" imageSize="70">capybara_brownie.svg</imageName>
		<imageName zLayer="3" imageRotation="0" imageSize="100">background_top.svg</imageName>
		
		<colourPrimary>NoStepOnSnek_capybara</colourPrimary>
		<colourSecondary/>
		<colourTertiary/>
		
		<potionDescriptor><![CDATA[capybara]]></potionDescriptor>
		<associatedRace>NoStepOnSnek_capybara</associatedRace>
		<enchantmentItemTypeId>ELIXIR</enchantmentItemTypeId>
		<enchantmentEffectId>RACE</enchantmentEffectId>
		
		<effectTooltipLines>
			<line><![CDATA[[style.boldGood(Восстанавливает)] 10% [style.boldHealth([#ATTRIBUTE_HEALTH_MAXIMUM.getName()])]]]></line>
			<line><![CDATA[[#ATTRIBUTE_MAJOR_PHYSIQUE.getFormattedValue(2)] к 'эффектам зелий']]></line>
		</effectTooltipLines>
		
		<applyEffects><![CDATA[
			[##npc.incrementHealth(npc.getAttributeValue(ATTRIBUTE_HEALTH_MAXIMUM)/10)]
			
			<p style='margin-bottom:0; padding-bottom:0;'>
				[npc.Name] [npc.verb(start)] чувствовать прилив сил...
			</p>
			[#npc.addPotionEffect(ATTRIBUTE_MAJOR_PHYSIQUE, 2)]
		]]></applyEffects>
		
		<itemTags>
			<tag>FOOD</tag>
			<tag>RACIAL_TF_ITEM</tag>
			<tag>SOLD_BY_RALPH</tag>
		</itemTags>
	</coreAttributes>

	<useDescriptions>
		<selfUse><![CDATA[
		[npc.Name] [npc.verb(take)] брауни из защитной коробочки и быстро [npc.verb(devour)] его, оставляя [npc.herHim] лишь восхитительный вкус шоколада, наполняющий [npc.her] рот.
		]]></selfUse>
		<otherUse><![CDATA[
		[npc.Name] [npc.verb(take)] брауни из защитной коробочки, подносит его к [npc2.namePos] [npc2.lips] и заставляет [npc2.herHim] съесть его. Быстро проглотив лакомство, [npc2.name] остается с восхитительным вкусом шоколада, наполняющим [npc2.her] рот.
		]]></otherUse>
	</useDescriptions>

	
</item>
